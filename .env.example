#######################################################
### BLOCKCHAIN CONFIGURATION
#######################################################

# REQUIRED - Blockchain ID
ANTELOPE_CHAIN_ID=aca376f206b8fc25a6ed44dbdc66547c36c6c33e3a119ffbeaef943642f0e906

# REQUIRED - API Endpoint (nodeos)
ANTELOPE_NODEOS_API=https://eos.greymass.com

# REQUIRED - System Token Symbol (e.g. "4,TOKEN")
ANTELOPE_SYSTEM_TOKEN=4,A

# System Contract to use during powerup, buyram, etc (default: core.vaulta)
# ANTELOPE_SYSTEM_CONTRACT=core.vaulta

# System Token Contract (default: core.vaulta)
# ANTELOPE_TOKEN_CONTRACT=core.vaulta

# Noop Contract to use for cosigning (default: greymassnoop)
# ANTELOPE_NOOP_CONTRACT=greymassnoop

# Sample account to use for resource calculations (default: eosio.reserv)
# ANTELOPE_SAMPLE_ACCOUNT=eosio.reserv

#######################################################
### SELF-MANAGEMENT
### Automatically manages the service account's own
### CPU, NET, and RAM to keep the service operational.
#######################################################

# Enable self-management (default: true)
# ENABLE_SELF_MANAGEMENT=true

# REQUIRED - Account name used by the service
# MANAGER_ACCOUNT_NAME=

# Private key to the account/permission (will automatically generate if not defined)
# MANAGER_ACCOUNT_PRIVATEKEY=

# Permission on the account to use (default: "manager")
# MANAGER_ACCOUNT_PERMISSION=manager

# The minimum available CPU (in milliseconds) before a powerup is triggered (default: 5)
# MANAGER_MIN_MS=5

# The minimum available NET (in kilobytes) before a powerup is triggered (default: 5)
# MANAGER_MIN_KB=5

# The amount of CPU (in milliseconds) to powerup when needed (default: 10)
# MANAGER_INC_MS=10

# The amount of NET (in kilobytes) to powerup when needed (default: 10)
# MANAGER_INC_KB=10
# Renew leases this many minutes before they expire (0 disables)
# MANAGER_RENEW_BEFORE_EXPIRY_MINUTES=120

# Maximum payment per self-management powerup (default: 0.1000)
# MANAGER_MAX_FEE=0.1000

# Allow automatic RAM purchases to keep the account operational (default: true)
# MANAGER_BUYRAM_ENABLED=true

# The minimum amount of available RAM (in KB) the account should have (default: 1)
# MANAGER_RAM_MINIMUM_KB=1

# The action used on the system contract to buy RAM (default: buyrambytes)
# MANAGER_BUYRAM_ACTION=buyrambytes

# The interval at which self-management runs (cron style, default: every 30 seconds)
# MANAGER_SELF_CRONJOB='0/30 * * * * *'

# Renew the manager account's own leases this many minutes before they expire (0 disables, default: 360).
# Longer than MANAGER_RENEW_BEFORE_EXPIRY_MINUTES: once the payer's CPU hits 0 it cannot pay for anyone else.
# MANAGER_SELF_RENEW_BEFORE_EXPIRY_MINUTES=360

# Maximum backoff between failed startup checks; they are retried until they succeed (default: 60)
# MANAGER_SELF_RETRY_MAX_SECONDS=60

# Abandon a self-management check that takes longer than this, so the next one can run (default: 120)
# MANAGER_SELF_CHECK_TIMEOUT_SECONDS=120

# CPU (ms) the payer must have to pay for managed accounts; below it the payer is rescued first (default: 3)
# MANAGER_PAYER_RESERVE_MS=3

#######################################################
### ALERTS
### Logged at error level, and POSTed as JSON
### ({ text, content, alert }) to ALERT_WEBHOOK_URL.
#######################################################

# Optional webhook (Slack/Discord-compatible JSON). Keep it out of logs and version control.
# ALERT_WEBHOOK_URL=

# Minimum minutes between repeats of the same firing alert (default: 30)
# ALERT_REPEAT_MINUTES=30

# Alert when the lease carrying most of an account's CPU/NET expires within this many minutes
# without having been renewed (0 disables, default: 60)
# ALERT_LEASE_EXPIRY_MINUTES=60

# Alert when an account (or the payer) stays below its CPU minimum this long (0 disables, default: 120)
# ALERT_CPU_GRACE_SECONDS=120

# Alert when the payer's liquid balance falls below this, in system tokens (0 disables, default: 100)
# ALERT_PAYER_MIN_BALANCE=100

# Alert when self-management has not completed a check for this many minutes (0 disables, default: 5)
# ALERT_SELF_STALE_MINUTES=5

#######################################################
### AUTOMATED RESOURCE MANAGEMENT
### Manages CPU and NET for a list of other
### accounts on the network.
#######################################################

# Enable the automated resource management system (default: false)
ENABLE_RESOURCE_MANAGER=false

# The interval at which the manager will evaluate managed accounts (cron style)
# MANAGER_CRONJOB='0/10 * * * * *'

# Seconds to skip an account after a successful powerup (default: 300)
# MANAGER_POWERUP_COOLDOWN_SECONDS=300

# Buy RAM for managed accounts that set min_ram_kb/inc_ram_kb (Jungle 4 only, default: false)
# ENABLE_MANAGED_ACCOUNT_RAM=false

# Maximum estimated cost of a single managed-account RAM purchase, in system tokens (default: 5)
# MANAGED_ACCOUNT_RAM_MAX_FEE=5

# Default cap on estimated RAM spend per managed account per rolling 24h, in system tokens
# (0 = no cap, default: 0). An account's own ram_daily_max_fee (manager add ... [ram_daily_max_fee]) overrides it.
# MANAGED_ACCOUNT_RAM_DAILY_MAX_FEE=0


#######################################################
### RESOURCE PROVIDER CONFIGURATION
### Cosigns transactions for requesting accounts,
### providing CPU and NET via PowerUp.
#######################################################

### ---------------------------------------------------
### PROVIDER ACCOUNT

# Enable the resource provider API (default: false)
# ENABLE_RESOURCE_PROVIDER=false

# REQUIRED (when enabled) - Account name of the cosigning account
# PROVIDER_ACCOUNT_NAME=

# Permission on the account to use (default: "provider")
# PROVIDER_ACCOUNT_PERMISSION=provider

# Private key to the account/permission (will automatically generate if not defined)
# PROVIDER_ACCOUNT_PRIVATEKEY=

# Require that the requesting account actually needs resources before cosigning (default: true)
# PROVIDER_REQUIRE_RESOURCE_NEED=true

# Minimum available CPU (in microseconds) below which the account is considered in need (default: 50000)
# PROVIDER_MIN_CPU_US=50000

# Minimum available NET (in bytes) below which the account is considered in need (default: 50000)
# PROVIDER_MIN_NET_BYTES=50000

# Rolling window for usage tracking in hours (default: 24)
# PROVIDER_USAGE_WINDOW_HOURS=24

# Cron schedule for cleaning up expired usage records (default: hourly)
# PROVIDER_USAGE_CLEANUP_CRON='0 * * * *'

### ---------------------------------------------------
### FREE POWERUPS

# Enable direct free powerups (default: false)
# ENABLE_FREE_POWERUP=false

# CPU Amount (ms) to provide in a free powerup (required when enabled)
# PROVIDER_FREE_POWERUP_MS=1

# NET Amount (kb) to provide in a free powerup (required when enabled)
# PROVIDER_FREE_POWERUP_KB=1

# Number of uses per account, per day (required when enabled)
# PROVIDER_FREE_POWERUP_USES=1

# Maximum payment per free powerup (required when enabled)
# PROVIDER_FREE_POWERUP_MAX_PAYMENT=1.0000

### ---------------------------------------------------
### FREE COSIGNING

# Enable free transaction cosigning (default: false)
# ENABLE_FREE_TRANSACTIONS=false

# CPU Amount (ms) to allow per day via cosigning (required when enabled)
# PROVIDER_FREE_TRANSACTIONS_LIMIT_MS=10

# NET Amount (kb) to allow per day via cosigning (required when enabled)
# PROVIDER_FREE_TRANSACTIONS_LIMIT_KB=10

### ---------------------------------------------------
### PAID COSIGNING

# Enable fee-based transaction cosigning (default: true)
# ENABLE_PAID_TRANSACTIONS=true

# Minimum fee for all transactions (default: 0.0001, symbol derived from ANTELOPE_SYSTEM_TOKEN)
# PROVIDER_PAID_TRANSACTIONS_MINIMUM_FEE=0.0001

# Account to receive fee payments (default: cosigner account)
# PROVIDER_PAID_TRANSACTIONS_FEE_RECIPIENT=

# Memo prefix for fee transfer (default: "Fuel Transaction Fee")
# PROVIDER_PAID_TRANSACTIONS_FEE_MEMO=Fuel Transaction Fee

# Default referrer appended to fee memo as "| ref={value}" (default: teamgreymass)
# PROVIDER_PAID_TRANSACTIONS_FEE_DEFAULT_REF=teamgreymass

### ---------------------------------------------------
### LIGHT ACCOUNT COSIGNING

# Enable the light account cosigning endpoint (default: false)
# ENABLE_LIGHTACCOUNT_PROVIDER=false

# REQUIRED (when enabled) - Light account contract name
# LIGHTACCOUNT_CONTRACT=lightacct

# REQUIRED (when enabled) - Keyhost account name
# LIGHTACCOUNT_KEYHOST=

# Fee multiplier over base PowerUp cost (default: 1.0, e.g. 1.5 for 50% margin)
# LIGHTACCOUNT_FEE_MARGIN=1.0

# REQUIRED (when enabled) - Public key of the light account that receives fees
# LIGHTACCOUNT_FEE_RECIPIENT_KEY=

#######################################################
### GENERAL CONFIGURATION
#######################################################

# ENVIRONMENT=production
# SERVICE_HTTP_PORT=3000
# SERVICE_LOG_LEVEL=info
# SERVICE_INFO_LOG=./info.log
# SERVICE_ERROR_LOG=./error.log

# DATABASE_FILE="resource-provider.db"

# Standalone gifted-RAM sponsor (optional; disabled unless both values are configured).
# Only enable for Jungle4 with a deployed ram-manager and a dedicated service token.
# RAM_MANAGER_URL=https://ram-manager.example
# RAM_MANAGER_TOKEN=<transaction-pass-client-provision-api-key>
